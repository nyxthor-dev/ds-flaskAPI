# --- Credenciales DeepSeek (obligatorias) ---
DEEPSEEK_TOKEN=tu_token
DEEPSEEK_COOKIES=tu_cookies
DEEPSEEK_LOGIN_DIR=.login_api

# --- Seguridad de tu API ---
# Genera una o varias keys propias, ej: openssl rand -hex 32
API_KEYS=cambia-esto-por-una-key-larga-y-aleatoria
REQUIRE_API_KEY=true

# --- CORS ---
# En producción, restringe a tus dominios: https://tuapp.com,https://otra.com
CORS_ORIGINS=*

# --- Logging ---
LOG_LEVEL=INFO
# Deja en false para no loguear el contenido de prompts/respuestas (privacidad)
LOG_PROMPT_CONTENT=false

# --- Entorno ---
FLASK_ENV=production
EXPOSE_ERROR_DETAILS=false

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=60 per minute
RATE_LIMIT_STORAGE_URI=memory://

# --- Concurrencia hacia el backend de DeepSeek ---
MAX_CONCURRENT_CHATS=4
CHAT_TIMEOUT_SECONDS=120

PORT=5000
